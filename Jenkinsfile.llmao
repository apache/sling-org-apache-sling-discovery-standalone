@Library('sling_private@feat/llmao') _

// Configure a separate Pipeline job with this SCM script path and branch feat/llmao.
// The job needs the Secret text credential llmao-pat; use Build Now for testing.
slingOsgiBundleBuild(
    llmaoOnly: true,
    llmaoRebuildFrequency: '', // Manual only for now; set '@weekly' to enable cron.
    llmaoModel: 'qwen3.8-27b',
    llmaoInput: 'Update this project to the most recent released parent POM version and respond only with SUCCESS or FAILURE'
)
